# Copia este archivo como .env (o .env.local) y llena los valores.
# Los encuentras en Supabase > Project Settings > API (o "Connect").

# URL del proyecto, p. ej. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Clave pública "anon" (o la nueva "publishable key", sb_publishable_...).
# NUNCA pongas aquí la service_role / secret key.
VITE_SUPABASE_ANON_KEY=

# Dominios de correo permitidos para registrarse, separados por coma.
# Déjalo vacío para aceptar cualquier correo.
VITE_ALLOWED_EMAIL_DOMAINS=gmail.com

# (Opcional) URL pública donde publicarás la app, p. ej. https://metacash.vercel.app
# Se usa en los enlaces de confirmación y recuperación de contraseña.
# Si la dejas vacía se usa la dirección actual del navegador.
VITE_SITE_URL=

# (Opcional) Cuántos dígitos tiene el código que llega por correo.
# Debe ser igual a "Email OTP Length" en Supabase (Authentication > Providers > Email). Por defecto 6.
VITE_OTP_LENGTH=6
